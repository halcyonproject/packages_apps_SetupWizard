<android.widget.FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <org.lineageos.setupwizard.widget.RevealHoleView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        style="@style/SudContentFrame">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cool_branding_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="h."
                style="@style/halcyonCoolBranding"/>

            <TextView
                android:id="@+id/finished_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/setup_finished_message"
                android:paddingBottom="@dimen/welcome_content_container_padding_bottom"
                style="@style/WelcomeSubTitle"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/swipe_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/swipe_hint_padding_bottom">

            <ImageView
                android:id="@+id/swipe_hint_icon"
                android:layout_width="@dimen/swipe_hint_icon_size"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_swipe_up"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/swipe_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/swipe_hint_text_margin_top"
                android:text="@string/swipe_up_to_go_home"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textSize="@dimen/swipe_hint_text_size" />
        </LinearLayout>

    </LinearLayout>

</android.widget.FrameLayout>
